# Copy to .env (git-ignored) and fill in. Never commit real keys.

# --- GridMind optional Nemotron policy ---------------------------------------
# Get an API key from https://tokenfactory.nebius.com/project/api-keys
# An authorized live smoke request (catalogue + one inference) requires:
#   uv run python scripts/smoke_test_nemotron.py --live
# Catalogue-only check (also explicitly opt-in):
#   uv run python scripts/smoke_test_nemotron.py --live --catalogue
# Set GRIDMIND_MODEL to the exact NVIDIA/Nemotron ID returned by /v1/models.
# Never expose NEBIUS_API_KEY via VITE_* or another frontend variable.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
GRIDMIND_MODEL=
GRIDMIND_INFERENCE_TIMEOUT_SECONDS=15

# --- Option A: Nebius Token Factory, per-role models -------------------------
# SCALER_PROVIDER=nebius
# NEBIUS_API_KEY=your_key_here
# SCALER_PLANNING_MODEL=<id from: python scripts/smoke_test_models.py --list-models>
# SCALER_DISPATCH_MODEL=<id>
# SCALER_MARKET_MODEL=<id>
# or one model for every role (homogeneous baseline):  SCALER_MODEL=<id>
# or a file:  SCALER_MODELS_FILE=config/models.example.yaml
# Optional: SCALER_TRACE_DIR=traces     MAX_EVAL_STEPS=0 (0 = full episodes)

# --- Option B: original single-provider setup (unchanged) --------------------
# API_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# PLANNING_MODEL=openai/gpt-oss-120b
# HF_TOKEN=your_key_here
